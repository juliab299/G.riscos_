package br.com.techmaster.gestaoriscos.dao;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

public class ConnectionFactory {
	private static final String URL = "jdbc:h2:~/gestao_riscos_db";
    private static final String USER = "sa";
    private static final String PASSWORD = "sa";

    /**
     * @return 
     */
    public static Connection getConnection() throws SQLException {
        try {
            Class.forName("org.h2.Driver");
            return DriverManager.getConnection(URL, USER, PASSWORD);
        } catch (ClassNotFoundException e) {
            System.err.println("Driver JDBC H2 não encontrado.");
            throw new SQLException("Falha ao carregar o driver JDBC.", e);
        }
    }

    /**
     * @param 
     */
    public static void closeConnection(Connection conn) {
        if (conn != null) {
            try {
                conn.close();
            } catch (SQLException e) {
                System.err.println("Erro ao fechar a conexão: " + e.getMessage());
            }
        }
    }
}
