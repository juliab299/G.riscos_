<%-- /src/main/webapp/lista-riscos.jsp --%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %> <%-- Importa a biblioteca JSTL --%>
<!DOCTYPE html><html>
<head>
    <meta charset="UTF-8">
    <title>Gestão de Riscos</title>
    <%-- Adicione um CSS básico para melhorar a aparência --%>
</head>
<body>
    <h1>Lista de Riscos Identificados</h1>
    <a href="riscos?acao=novo">Adicionar Novo Risco</a>
    <hr>
    <table border="1">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descrição</th>
                <th>Origem</th>
                <th>Status</th>
                <th>Tipo</th>
                <th>Data de Identificação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <%-- Itera sobre a lista de riscos enviada pelo Servlet --%>
            <c:forEach var="risco" items="${listaRiscos}">
                <tr>
                    <td>${risco.id}</td>
                    <td>${risco.descricao}</td>
                    <td>${risco.origem}</td>
                    <td>${risco.status}</td>
                    <td>${risco.tipoRisco.nome}</td>
                    <td>${risco.dataIdentificacao}</td>
                    <td>
                        <a href="riscos?acao=editar&id=${risco.id}">Editar</a>
                        <a href="riscos?acao=excluir&id=${risco.id}">Excluir</a>
                    </td>
                </tr>
            </c:forEach>
        </tbody>
    </table>
</body>
</html>