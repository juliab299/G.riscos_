public Risco buscarPorId(int id) {
    String sql = "SELECT r.*, tr.nome as nome_tipo FROM RISCO r " +
                 "INNER JOIN TIPO_RISCO tr ON r.id_tipo_risco = tr.id WHERE r.id = ?";
    Risco risco = null;

    try (Connection conn = ConnectionFactory.getConnection();
         PreparedStatement pstmt = conn.prepareStatement(sql)) {
        
        pstmt.setInt(1, id);
        ResultSet rs = pstmt.executeQuery();

        if (rs.next()) {
            risco = new Risco();
            risco.setId(rs.getInt("id"));
            risco.setDescricao(rs.getString("descricao"));
            risco.setOrigem(rs.getString("origem"));
            risco.setContexto(rs.getString("contexto"));
            risco.setDataIdentificacao(rs.getDate("data_identificacao").toLocalDate());
            risco.setStatus(rs.getString("status"));

            TipoRisco tipo = new TipoRisco();
            tipo.setId(rs.getInt("id_tipo_risco"));
            tipo.setNome(rs.getString("nome_tipo"));
            risco.setTipoRisco(tipo);
        }
        rs.close();
    } catch (SQLException e) {
        e.printStackTrace();
    }
    return risco;
}

public void atualizar(Risco risco) {
    String sql = "UPDATE RISCO SET descricao = ?, origem = ?, contexto = ?, data_identificacao = ?, status = ?, id_tipo_risco = ? WHERE id = ?";

    try (Connection conn = ConnectionFactory.getConnection();
         PreparedStatement pstmt = conn.prepareStatement(sql)) {

        pstmt.setString(1, risco.getDescricao());
        pstmt.setString(2, risco.getOrigem());
        pstmt.setString(3, risco.getContexto());
        pstmt.setDate(4, Date.valueOf(risco.getDataIdentificacao()));
        pstmt.setString(5, risco.getStatus());
        pstmt.setInt(6, risco.getTipoRisco().getId());
        pstmt.setInt(7, risco.getId());

        pstmt.executeUpdate();
    } catch (SQLException e) {
        e.printStackTrace();
    }
}

public void excluir(int id) {
    String sql = "DELETE FROM RISCO WHERE id = ?";

    try (Connection conn = ConnectionFactory.getConnection();
         PreparedStatement pstmt = conn.prepareStatement(sql)) {
        
        pstmt.setInt(1, id);
        pstmt.executeUpdate();

    } catch (SQLException e) {
        // Tratamento de erro: um risco pode ter dependências (avaliações, etc.)
