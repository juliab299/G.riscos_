package br.com.techmaster.gestaoriscos.model;
import java.time.LocalDate;
public class AcaoPlano {

	 private Long id;
	    private PlanoMitigacao plano; 
	    private Pessoa responsavel;
	    
	    private String descricaoAcao;
	    private LocalDate prazoLimite;
	    private LocalDate dataConclusao;
	    private int progresso; 
	    private String observacoes;
		public Long getId() {
			return id;
		}
		public void setId(Long id) {
			this.id = id;
		}
		public PlanoMitigacao getPlano() {
			return plano;
		}
		public void setPlano(PlanoMitigacao plano) {
			this.plano = plano;
		}
		public Pessoa getResponsavel() {
			return responsavel;
		}
		public void setResponsavel(Pessoa responsavel) {
			this.responsavel = responsavel;
		}
		public String getDescricaoAcao() {
			return descricaoAcao;
		}
		public void setDescricaoAcao(String descricaoAcao) {
			this.descricaoAcao = descricaoAcao;
		}
		public LocalDate getPrazoLimite() {
			return prazoLimite;
		}
		public void setPrazoLimite(LocalDate prazoLimite) {
			this.prazoLimite = prazoLimite;
		}
		public LocalDate getDataConclusao() {
			return dataConclusao;
		}
		public void setDataConclusao(LocalDate dataConclusao) {
			this.dataConclusao = dataConclusao;
		}
		public int getProgresso() {
			return progresso;
		}
		public void setProgresso(int progresso) {
			this.progresso = progresso;
		}
		public String getObservacoes() {
			return observacoes;
		}
		public void setObservacoes(String observacoes) {
			this.observacoes = observacoes;
		}
	    
}
